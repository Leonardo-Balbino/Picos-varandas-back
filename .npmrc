# auto-install-peers=true (padrão do pnpm) instala silenciosamente QUALQUER
# peer dependency opcional de QUALQUER pacote do grafo, mesmo sem uso real.
# Foi assim que Prisma Studio, `effect`, `@electric-sql/pglite` (~120 MB,
# peer opcional de @prisma/client via `prisma`) e class-validator/
# class-transformer (peer opcional de @nestjs/common, removidos na
# Correção 1) voltaram a aparecer em `pnpm deploy --prod`, mesmo não
# estando em nenhum package.json do projeto. Descoberto medindo o tamanho
# real de `pnpm deploy --filter api --prod --legacy` (Card A1 — seção 3.5).
auto-install-peers=false
